# ============================================================
# KAIA TECHNOLOGIES — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# Copy this file to .env and configure for your target environment.
# NEVER commit .env to version control.
# NEVER expose RAZORPAY_KEY_SECRET, AWS_SECRET_ACCESS_KEY, or JWT_SECRET to the client.
# ============================================================

# ─── SERVER CONFIGURATION ──────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MONGODB ATLAS DATABASE ────────────────────────────────
# Production connection string format:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin_user:REPLACE_WITH_STRONG_PASSWORD@cluster0.mongodb.net/kaia-tech?retryWrites=true&w=majority

# ─── JWT AUTHENTICATION & SECURITY ─────────────────────────
# Minimum 256-bit cryptographically random strings:
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_REFRESH_KEY

# ─── PAYMENT GATEWAY (RAZORPAY) ────────────────────────────
# Set PAYMENT_PROVIDER to: razorpay | mock
PAYMENT_PROVIDER=razorpay

# Set PAYMENT_MODE to: test | live
PAYMENT_MODE=test

# Public Key ID (may be shared with frontend client)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Secret Key (Strictly Server-Side Only)
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Webhook Secret configured in Razorpay Dashboard for HMAC-SHA256 verification
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ─── OBJECT STORAGE (AWS S3) ───────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET=kaia-production-assets

# Optional CloudFront CDN Domain:
# CDN_DOMAIN=https://d123456abcdef8.cloudfront.net

# ─── LOGISTICS & SHIPPING PROVIDER ─────────────────────────
# Supported providers: shiprocket | bluedart | delhivery
SHIPPING_PROVIDER=shiprocket
SHIPPING_API_KEY=YOUR_SHIPPING_API_KEY
SHIPPING_API_SECRET=YOUR_SHIPPING_API_SECRET
SHIPPING_WEBHOOK_SECRET=YOUR_SHIPPING_WEBHOOK_SECRET

# ─── TRANSACTIONAL EMAIL NOTIFICATIONS ─────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ─── OTP CONFIGURATION ─────────────────────────────────────
# OTP expiry in minutes (default: 5)
OTP_EXPIRY_MINUTES=5

# ─── SMS / WHATSAPP ALERTS ─────────────────────────────────
# SMS_PROVIDER=twilio
# SMS_ACCOUNT_SID=YOUR_ACCOUNT_SID
# SMS_AUTH_TOKEN=YOUR_AUTH_TOKEN
# SMS_FROM=+1234567890

# ─── CORS & TRUSTED ORIGINS ────────────────────────────────
FRONTEND_URL=https://www.kaia-technologies.com
API_BASE_URL=https://api.kaia-technologies.com
