{
  "name": "kaia-technologies",
  "version": "1.0.0",
  "description": "Premium multi-brand electronics marketplace",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm start --prefix backend",
    "client": "npm run dev --prefix frontend",
    "seed": "node backend/scripts/seed.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.6"
  }
}
